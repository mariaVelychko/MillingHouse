generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  slug        String    @id
  title       String
  singular    String?
  icon        String?
  imageUrl    String?
  searchTerms String[]
  products    Product[]
}

model Product {
  id           Int            @id @default(autoincrement())
  sku          String?        @unique
  slug         String         @unique
  title        String
  description  String?
  material     String?
  heightCm     Float?
  widthCm      Float?
  priceUah     Int?
  oldPriceUah  Int?
  inStock      Boolean        @default(true)
  colors       String[]
  specs        Json?
  createdAt    DateTime       @default(now())
  category     Category       @relation(fields: [categorySlug], references: [slug])
  categorySlug String
  images       ProductImage[]

  @@index([categorySlug])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  url       String
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int

  @@index([productId])
}
