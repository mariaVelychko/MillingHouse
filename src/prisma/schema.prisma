generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  slug        String    @id
  title       String
  singular    String?
  icon        String?
  imageUrl    String?
  searchTerms String[]
  products    Product[]
}

model Product {
  id           Int            @id @default(autoincrement())
  sku          String?        @unique
  slug         String         @unique
  title        String
  description  String?
  material     String?
  heightCm     Float?
  widthCm      Float?
  priceUah     Int?
  oldPriceUah  Int?
  inStock      Boolean        @default(true)
  colors       String[]
  specs        Json?
  createdAt    DateTime       @default(now())
  category     Category       @relation(fields: [categorySlug], references: [slug])
  categorySlug String
  images       ProductImage[]

  @@index([categorySlug])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  url       String
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Int

  @@index([productId])
}

// Замовлення. Ціни зберігаємо знімком на момент покупки (unitPriceUah),
// щоб зміна ціни товару не змінювала старі замовлення.
model Order {
  id             Int         @id @default(autoincrement())
  number         String      @unique
  status         String      @default("new")      // new | paid | shipped | done | cancelled
  customerName   String
  phone          String
  email          String?
  comment        String?
  deliveryMethod String                            // nova_poshta | pickup
  city           String?
  warehouse      String?                           // відділення / поштомат Нової Пошти
  paymentMethod  String                            // cod (при отриманні) | card (LiqPay)
  paymentStatus  String      @default("pending")  // pending | paid | failed
  totalUah       Int
  createdAt      DateTime    @default(now())
  items          OrderItem[]
}

model OrderItem {
  id           Int     @id @default(autoincrement())
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      Int
  productId    Int?
  slug         String
  title        String
  unitPriceUah Int
  quantity     Int

  @@index([orderId])
}
